{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-editing/schemas/style-template.v1.json",
  "title": "Style Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style_id",
    "name",
    "source_observations",
    "grammar",
    "requirements",
    "confidence",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "style-template.v1"
    },
    "style_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narrative_shape": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hook_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "median_shot_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "cuts_per_minute": {
          "type": [
            "number",
            "null"
          ]
        },
        "broll_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "payoff_position": {
          "enum": [
            "early",
            "mid",
            "late",
            "none",
            null
          ]
        },
        "jl_transitions": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "uses_voiceover": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "caption_style": {
          "enum": [
            "none",
            "minimal",
            "heavy",
            null
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs_payoff": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dialogue_density": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "min_distinct_shots": {
          "type": [
            "integer",
            "null"
          ]
        },
        "needs_broll": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
