{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-editing/schemas/style-template.v1.json",
  "title": "Style Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style_id",
    "name",
    "source_observations",
    "grammar",
    "requirements",
    "confidence",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "style-template.v1"
    },
    "style_id": {
      "type": "string",
      "pattern": "^style-[a-f0-9]{8}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "generated_at": {
      "type": "string"
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narrative_shape": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "hook",
              "setup",
              "attempt",
              "failure",
              "debugging",
              "retry",
              "payoff",
              "reflection",
              "montage",
              "explainer",
              "daily_routine",
              "reveal"
            ]
          }
        },
        "hook_type": {
          "enum": [
            "unexpected_result",
            "question",
            "bold_claim",
            "in_media_res",
            "greeting",
            "visual_spectacle",
            "problem_statement",
            "none",
            null
          ]
        },
        "tone": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "calm",
              "casual",
              "chaotic",
              "cinematic",
              "cozy",
              "dramatic",
              "educational",
              "emotional",
              "energetic",
              "formal",
              "funny",
              "informative",
              "inspirational",
              "intense",
              "minimal",
              "nostalgic",
              "personal",
              "playful",
              "raw",
              "reflective",
              "sarcastic",
              "serious",
              "upbeat",
              "wholesome"
            ]
          }
        },
        "median_shot_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "cuts_per_minute": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "broll_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "payoff_position": {
          "enum": [
            "early",
            "mid",
            "late",
            "none",
            null
          ]
        },
        "jl_transitions": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "uses_voiceover": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "caption_style": {
          "enum": [
            "none",
            "minimal",
            "heavy",
            null
          ]
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs_payoff": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dialogue_density": {
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        },
        "min_distinct_shots": {
          "type": [
            "integer",
            "null"
          ]
        },
        "needs_broll": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}