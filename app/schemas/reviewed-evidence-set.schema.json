{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-editing/schemas/reviewed-evidence-set.v1.json",
  "title": "Finalized reviewed provider evidence and scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "generated_at",
    "project_id",
    "status",
    "planning_eligible",
    "recommendation",
    "comparison",
    "candidate_sets",
    "material_conflicts",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "reviewed-evidence-set.v1"},
    "revision_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "conflicts_require_resolution",
        "deterministic_rerun_required",
        "provider_selection_required"
      ]
    },
    "planning_eligible": {"type": "boolean"},
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "winner_run_key", "reason", "next_action"],
      "properties": {
        "status": {
          "enum": [
            "conflicts_require_resolution",
            "deterministic_rerun_required",
            "provider_selection_required"
          ]
        },
        "winner_run_key": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directly_comparable", "reason", "candidate_count"],
      "properties": {
        "directly_comparable": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "candidate_count": {"type": "integer", "minimum": 1}
      }
    },
    "candidate_sets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateSet"}
    },
    "material_conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "id", "model"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_count",
        "rejected_count",
        "edited_count",
        "approval_rate"
      ],
      "properties": {
        "status": {"const": "reviewed"},
        "approved_count": {"type": "integer", "minimum": 0},
        "rejected_count": {"type": "integer", "minimum": 0},
        "edited_count": {"type": "integer", "minimum": 0},
        "approval_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "qualitySignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clamped_count",
        "risk_flagged_count",
        "flagged_approved_count",
        "material_conflict_count"
      ],
      "properties": {
        "clamped_count": {"type": "integer", "minimum": 0},
        "risk_flagged_count": {"type": "integer", "minimum": 0},
        "flagged_approved_count": {"type": "integer", "minimum": 0},
        "material_conflict_count": {"type": "integer", "minimum": 0}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_count",
        "min_shot_duration_ms",
        "max_shot_duration_ms",
        "visual_seconds",
        "end_to_end_seconds"
      ],
      "properties": {
        "split_count": {"type": ["integer", "null"], "minimum": 0},
        "min_shot_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "max_shot_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "visual_seconds": {"type": ["number", "null"], "minimum": 0},
        "end_to_end_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "acceptedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "asset_id",
        "filename",
        "start_seconds",
        "end_seconds",
        "observation",
        "original_observation",
        "review_note",
        "reviewed_at",
        "adjustments",
        "risk_flags",
        "conflict_ids"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0},
        "observation": {"type": "string", "minLength": 1},
        "original_observation": {"type": "string", "minLength": 1},
        "review_note": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "adjustments": {"type": "array", "items": {"type": "string"}},
        "risk_flags": {"type": "array", "items": {"type": "string"}},
        "conflict_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rejectedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "asset_id",
        "filename",
        "start_seconds",
        "end_seconds",
        "original_observation",
        "review_note",
        "reviewed_at"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0},
        "original_observation": {"type": "string", "minLength": 1},
        "review_note": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "run_key",
        "evidence_id",
        "provider_id",
        "asset_id",
        "filename",
        "start_seconds",
        "end_seconds",
        "severity",
        "status",
        "summary",
        "verified_observation",
        "verification_source"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "run_key": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "minimum": 0},
        "severity": {"enum": ["material"]},
        "status": {"const": "unresolved"},
        "summary": {"type": "string", "minLength": 1},
        "verified_observation": {"type": "string", "minLength": 1},
        "verification_source": {"type": "string", "minLength": 1}
      }
    },
    "candidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_key",
        "run_id",
        "provider",
        "review",
        "quality_signals",
        "benchmark",
        "eligible_for_planning",
        "accepted_evidence",
        "rejected_evidence",
        "material_conflicts"
      ],
      "properties": {
        "run_key": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "provider": {"$ref": "#/$defs/provider"},
        "review": {"$ref": "#/$defs/review"},
        "quality_signals": {"$ref": "#/$defs/qualitySignals"},
        "benchmark": {"$ref": "#/$defs/benchmark"},
        "eligible_for_planning": {"type": "boolean"},
        "accepted_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/acceptedEvidence"}
        },
        "rejected_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/rejectedEvidence"}
        },
        "material_conflicts": {
          "type": "array",
          "items": {"$ref": "#/$defs/conflict"}
        }
      }
    }
  }
}
