{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-editing/schemas/creative-concepts.v1.json",
  "title": "Creative Concepts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "benchmark_id",
    "footage_summary",
    "concepts"
  ],
  "properties": {
    "schema_version": {
      "const": "creative-concepts.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "benchmark_id": {
      "type": "string"
    },
    "footage_summary": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "concepts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "style_application": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "style-application.v1"
        },
        "style_id": {
          "type": "string",
          "pattern": "^style-[a-f0-9]{8}$"
        },
        "template_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "analyzers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "guidance_block": {
          "type": "string",
          "maxLength": 4000
        },
        "application": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "style_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^style-[a-f0-9]{8}$"
            },
            "template_confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "broll_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "median_shot_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "cuts_per_minute": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "target_tiers": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "measured",
                  "semantic"
                ]
              }
            },
            "owners": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "planner",
                  "compiler"
                ]
              }
            },
            "unsupported": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "start_seconds",
        "end_seconds",
        "observed_content",
        "confidence"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "observed_content": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "missingShot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "recording_instruction",
        "priority",
        "fallback"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "recording_instruction": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "required",
            "recommended",
            "optional"
          ]
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_id",
        "title",
        "topic",
        "audience",
        "platforms",
        "target_duration_seconds",
        "hook",
        "structure",
        "strengths",
        "weaknesses",
        "missing_shots"
      ],
      "properties": {
        "concept_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_duration_seconds": {
          "type": "number",
          "minimum": 1
        },
        "hook": {
          "type": "string"
        },
        "structure": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "beat_id",
              "purpose",
              "target_duration_seconds",
              "evidence"
            ],
            "properties": {
              "beat_id": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "target_duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "cutaways": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missingShot"
          }
        },
        "editorial": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "archetype": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 48,
              "pattern": "^[a-z0-9_]*$"
            },
            "narrative_shape": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "enum": [
                  "hook",
                  "setup",
                  "attempt",
                  "failure",
                  "debugging",
                  "retry",
                  "payoff",
                  "reflection",
                  "montage",
                  "explainer",
                  "daily_routine",
                  "reveal"
                ]
              }
            },
            "hook_type": {
              "enum": [
                "unexpected_result",
                "question",
                "bold_claim",
                "in_media_res",
                "greeting",
                "visual_spectacle",
                "problem_statement",
                "none",
                null
              ]
            },
            "tone": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "enum": [
                  "calm",
                  "casual",
                  "chaotic",
                  "cinematic",
                  "cozy",
                  "dramatic",
                  "educational",
                  "emotional",
                  "energetic",
                  "formal",
                  "funny",
                  "informative",
                  "inspirational",
                  "intense",
                  "minimal",
                  "nostalgic",
                  "personal",
                  "playful",
                  "raw",
                  "reflective",
                  "sarcastic",
                  "serious",
                  "upbeat",
                  "wholesome"
                ]
              }
            },
            "dialogue_density": {
              "enum": [
                "low",
                "medium",
                "high",
                null
              ]
            },
            "payoff": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "present": {
                  "type": "boolean"
                },
                "approximate_story_position": {
                  "enum": [
                    "early",
                    "mid",
                    "late",
                    "none",
                    null
                  ]
                }
              }
            }
          }
        },
        "style_provenance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    }
  }
}