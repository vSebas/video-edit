# Copy to .env, fill locally, and keep the resulting file private.
# Alibaba Model Studio keys and endpoints are workspace/region specific.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://your-workspace-host/compatible-mode/v1

# Google AI Studio / Gemini API key.
GEMINI_API_KEY=

# Optional writer challengers. Compose currently forwards OpenAI. A native
# Anthropic client exists, but ProjectService does not route planning through
# it and Compose does not forward its key; ANTHROPIC_API_KEY is reserved until
# both wiring gaps are closed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Protect the app before binding it beyond localhost. These values are also
# consumed by Compose for port/user configuration.
VIDEO_EDITING_TOKEN=
VIDEO_EDITING_BIND=127.0.0.1
VIDEO_EDITING_APP_PORT=8787
LOCAL_UID=1000
LOCAL_GID=1000

# Host-side OpenTake trial scripts read this value directly from .env.
OPENTAKE_MCP_TOKEN=

# Historical grounding benchmark only; not used by the application service.
TWELVELABS_API_KEY=

# Music discovery (optional). The official Instagram Audio API (Instagram
# Platform → Content Publishing → Audio API, the /ig_audio edge) searches IG's
# audio library and — with no query — returns trending music/original sounds.
# Requires an Instagram Business/Creator account, a Meta app with instagram_basic
# + instagram_content_publish, and a user access token. Unset → the model
# fallback suggests tracks from its own knowledge instead.
INSTAGRAM_ACCESS_TOKEN=
# Optional overrides (defaults shown):
# INSTAGRAM_GRAPH_URL=https://graph.instagram.com
# INSTAGRAM_API_VERSION=v21.0

# TikTok trending sounds (optional). TikTok has no clean public API — the
# Creative Center needs signed requests — so point this at a source you can
# reach (a Creative Center proxy you run, or a third-party TikTok trending API).
# Unset → the model fallback suggests TikTok-appropriate tracks instead.
MUSIC_TIKTOK_API_URL=
# MUSIC_TIKTOK_TRENDING_URL=   MUSIC_TIKTOK_API_KEY=   MUSIC_TIKTOK_REGION=MX
# MUSIC_TIKTOK_FIELD_MAP={"id":"clip_id","title":"title","artist":"author"}
