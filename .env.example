# Copy to .env, fill locally, and keep the resulting file private.
# Alibaba Model Studio keys and endpoints are workspace/region specific.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://your-workspace-host/compatible-mode/v1

# Google AI Studio / Gemini API key.
GEMINI_API_KEY=

# Optional writer challengers. Compose currently forwards OpenAI. The
# provider layer supports Anthropic too, but compose.yaml does not yet pass
# ANTHROPIC_API_KEY into the app container; inject it explicitly when used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Protect the app before binding it beyond localhost. These values are also
# consumed by Compose for port/user configuration.
VIDEO_EDITING_TOKEN=
VIDEO_EDITING_BIND=127.0.0.1
VIDEO_EDITING_APP_PORT=8787
LOCAL_UID=1000
LOCAL_GID=1000

# Host-side OpenTake trial scripts read this value directly from .env.
OPENTAKE_MCP_TOKEN=

# Historical grounding benchmark only; not used by the application service.
TWELVELABS_API_KEY=
